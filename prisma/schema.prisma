// ============================================================================
// ZivoShop Prisma Schema
// MySQL 8.0+ | Laravel-style conventions
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum ProductStatus {
  active
  draft
  archived
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
  returned
}

enum PaymentStatus {
  pending
  successful
  failed
  cancelled
  refunded
}

enum CouponType {
  fixed
  percent
}

enum ProductDetailType {
  text
  heading
  list
  image
  table
}

enum BannerPosition {
  hero
  campaign
  special_offer
  footer
  sidebar
}

enum BannerAlign {
  start
  center
}

enum SettingType {
  text
  json
  boolean
  integer
}

enum ActivityUserType {
  admin
  user
}

// =============================================================================
// MODELS
// =============================================================================

// ---------------------------------------------------------------------------
// 1. Admin
// ---------------------------------------------------------------------------
model Admin {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name      String    @db.VarChar(255)
  mobile    String    @unique @db.VarChar(20)
  email     String?   @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  orderStatusHistories OrderStatusHistory[]

  @@map("admins")
}

// ---------------------------------------------------------------------------
// 2. PasswordResetToken
// ---------------------------------------------------------------------------
model PasswordResetToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  mobile    String    @db.VarChar(20)
  token     String    @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([mobile])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// 3. PersonalAccessToken
// ---------------------------------------------------------------------------
model PersonalAccessToken {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenableType String    @db.VarChar(255) @map("tokenable_type")
  tokenableId   BigInt    @db.UnsignedBigInt @map("tokenable_id")
  name          String    @db.VarChar(255)
  token         String    @unique @db.VarChar(64)
  abilities     String?   @db.Text
  lastUsedAt    DateTime? @map("last_used_at")
  expiresAt     DateTime? @map("expires_at")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([tokenableType, tokenableId])
  @@map("personal_access_tokens")
}

// ---------------------------------------------------------------------------
// 4. Province
// ---------------------------------------------------------------------------
model Province {
  id           BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  name         String  @db.VarChar(100)
  slug         String  @unique @db.VarChar(100)
  shippingCost BigInt  @default(45000) @db.UnsignedBigInt @map("shipping_cost")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  cities    City[]
  addresses Address[]

  @@map("provinces")
}

// ---------------------------------------------------------------------------
// 5. City
// ---------------------------------------------------------------------------
model City {
  id         BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  provinceId BigInt @db.UnsignedBigInt @map("province_id")
  name       String @db.VarChar(100)
  slug       String @unique @db.VarChar(100)

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  province  Province  @relation(fields: [provinceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  addresses Address[]

  @@index([provinceId])
  @@map("cities")
}

// ---------------------------------------------------------------------------
// 6. Address
// ---------------------------------------------------------------------------
model Address {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt   @db.UnsignedBigInt @map("user_id")
  title         String   @db.VarChar(100)
  provinceId    BigInt   @db.UnsignedBigInt @map("province_id")
  cityId        BigInt   @db.UnsignedBigInt @map("city_id")
  postalCode    String   @db.VarChar(10) @map("postal_code")
  fullAddress   String   @db.Text @map("full_address")
  receiverName  String?  @db.VarChar(255) @map("receiver_name")
  receiverPhone String?  @db.VarChar(20) @map("receiver_phone")
  isDefault     Boolean  @default(false) @map("is_default")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  province Province @relation(fields: [provinceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  city     City     @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([provinceId])
  @@index([cityId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// 7. Category
// ---------------------------------------------------------------------------
model Category {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  parentId    BigInt?  @db.UnsignedBigInt @map("parent_id")
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  image       String?  @db.VarChar(500)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// 8. Brand
// ---------------------------------------------------------------------------
model Brand {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  logo        String?  @db.VarChar(500)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

// ---------------------------------------------------------------------------
// 9. Color
// ---------------------------------------------------------------------------
model Color {
  id   BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  name String @unique @db.VarChar(100)
  hex  String @db.VarChar(7)

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  productColors  ProductColor[]
  productVariants ProductVariant[]

  @@map("colors")
}

// ---------------------------------------------------------------------------
// 10. Size
// ---------------------------------------------------------------------------
model Size {
  id        BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  name      String @unique @db.VarChar(50)
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  productSizes   ProductSize[]
  productVariants ProductVariant[]

  @@map("sizes")
}

// ---------------------------------------------------------------------------
// 11. Product
// ---------------------------------------------------------------------------
model Product {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  categoryId      BigInt        @db.UnsignedBigInt @map("category_id")
  brandId         BigInt        @db.UnsignedBigInt @map("brand_id")
  name            String        @db.VarChar(500)
  slug            String        @unique @db.VarChar(500)
  description     String        @db.Text
  price           BigInt        @db.UnsignedBigInt
  discountPrice   BigInt?       @db.UnsignedBigInt @map("discount_price")
  discountPercent Int?           @map("discount_percent")
  stock           Int           @default(0)
  rating          Decimal       @default(0) @db.Decimal(3, 2)
  reviewCount     Int           @default(0) @map("review_count")
  status          ProductStatus @default(active)
  isNew           Boolean       @default(false) @map("is_new")
  isBestseller    Boolean       @default(false) @map("is_bestseller")
  seoTitle        String?       @db.VarChar(255) @map("seo_title")
  seoDescription  String?       @db.Text @map("seo_description")
  sortOrder       Int           @default(0) @map("sort_order")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brand          Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  images         ProductImage[]
  videos         ProductVideo[]
  details        ProductDetail[]
  productColors  ProductColor[]
  productSizes   ProductSize[]
  variants       ProductVariant[]
  reviews        Review[]
  orderItems     OrderItem[]
  wishlists      Wishlist[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([price])
  @@index([rating])
  @@index([isNew])
  @@index([isBestseller])
  @@index([createdAt])
  @@map("products")
}

// ---------------------------------------------------------------------------
// 12. ProductImage
// ---------------------------------------------------------------------------
model ProductImage {
  id        BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt  @db.UnsignedBigInt @map("product_id")
  path      String  @db.VarChar(500)
  alt       String? @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// 13. ProductVideo
// ---------------------------------------------------------------------------
model ProductVideo {
  id        BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt  @db.UnsignedBigInt @map("product_id")
  url       String  @db.VarChar(500)
  poster    String? @db.VarChar(500)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@map("product_videos")
}

// ---------------------------------------------------------------------------
// 14. ProductDetail
// ---------------------------------------------------------------------------
model ProductDetail {
  id        BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt            @db.UnsignedBigInt @map("product_id")
  type      ProductDetailType
  content   String?           @db.LongText
  src       String?           @db.VarChar(500)
  alt       String?           @db.VarChar(255)
  sortOrder Int               @default(0) @map("sort_order")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@map("product_details")
}

// ---------------------------------------------------------------------------
// 15. ProductColor
// ---------------------------------------------------------------------------
model ProductColor {
  id        BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt @db.UnsignedBigInt @map("product_id")
  colorId   BigInt @db.UnsignedBigInt @map("color_id")
  image     String? @db.VarChar(500)

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, colorId])
  @@index([colorId])
  @@map("product_colors")
}

// ---------------------------------------------------------------------------
// 16. ProductSize
// ---------------------------------------------------------------------------
model ProductSize {
  id        BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt  @db.UnsignedBigInt @map("product_id")
  sizeId    BigInt  @db.UnsignedBigInt @map("size_id")
  stock     Int     @default(0)
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  size    Size    @relation(fields: [sizeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, sizeId])
  @@index([sizeId])
  @@map("product_sizes")
}

// ---------------------------------------------------------------------------
// 17. ProductVariant
// ---------------------------------------------------------------------------
model ProductVariant {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId       BigInt   @db.UnsignedBigInt @map("product_id")
  colorId         BigInt?  @db.UnsignedBigInt @map("color_id")
  sizeId          BigInt?  @db.UnsignedBigInt @map("size_id")
  sku             String?  @unique @db.VarChar(100)
  stock           Int      @default(0)
  priceAdjustment BigInt   @default(0) @db.UnsignedBigInt @map("price_adjustment")
  isActive        Boolean  @default(true) @map("is_active")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  color   Color?  @relation(fields: [colorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  size    Size?   @relation(fields: [sizeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId])
  @@index([colorId])
  @@index([sizeId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// 18. Review
// ---------------------------------------------------------------------------
model Review {
  id               BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  productId        BigInt  @db.UnsignedBigInt @map("product_id")
  userId           BigInt  @db.UnsignedBigInt @map("user_id")
  rating           Int     @db.TinyInt
  title            String? @db.VarChar(255)
  content          String  @db.Text
  verifiedPurchase Boolean @default(false) @map("verified_purchase")
  isApproved       Boolean @default(false) @map("is_approved")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  images    ReviewImage[]

  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// 19. ReviewImage
// ---------------------------------------------------------------------------
model ReviewImage {
  id        BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  reviewId  BigInt  @db.UnsignedBigInt @map("review_id")
  path      String  @db.VarChar(500)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

// ---------------------------------------------------------------------------
// 20. Wishlist
// ---------------------------------------------------------------------------
model Wishlist {
  id        BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt @db.UnsignedBigInt @map("user_id")
  productId BigInt @db.UnsignedBigInt @map("product_id")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlists")
}

// ---------------------------------------------------------------------------
// 21. Coupon
// ---------------------------------------------------------------------------
model Coupon {
  id             BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  code           String     @unique @db.VarChar(50)
  type           CouponType @default(fixed)
  value          BigInt     @db.UnsignedBigInt
  minOrderAmount BigInt?    @db.UnsignedBigInt @map("min_order_amount")
  maxUses        Int?        @map("max_uses")
  usedCount      Int        @default(0)  @map("used_count")
  startsAt       DateTime?  @map("starts_at")
  expiresAt      DateTime?  @map("expires_at")
  isActive       Boolean    @default(true) @map("is_active")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  orders Order[]

  @@map("coupons")
}

// ---------------------------------------------------------------------------
// 22. Order
// ---------------------------------------------------------------------------
model Order {
  id             BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt      @db.UnsignedBigInt @map("user_id")
  orderNumber    String      @unique @db.VarChar(50) @map("order_number")
  couponId       BigInt?     @db.UnsignedBigInt @map("coupon_id")
  status         OrderStatus @default(pending)
  subtotal       BigInt      @db.UnsignedBigInt
  discountTotal  BigInt      @default(0) @db.UnsignedBigInt @map("discount_total")
  shippingCost   BigInt      @default(0) @db.UnsignedBigInt @map("shipping_cost")
  couponDiscount BigInt      @default(0) @db.UnsignedBigInt @map("coupon_discount")
  total          BigInt      @db.UnsignedBigInt
  receiverName   String      @db.VarChar(255) @map("receiver_name")
  receiverPhone  String      @db.VarChar(20) @map("receiver_phone")
  province       String      @db.VarChar(100)
  city           String      @db.VarChar(100)
  postalCode     String      @db.VarChar(10) @map("postal_code")
  fullAddress    String      @db.Text @map("full_address")
  customerNote   String?     @db.Text @map("customer_note")
  adminNote      String?     @db.Text @map("admin_note")
  trackNo        String?     @db.VarChar(100) @map("track_no")
  paidAt         DateTime?   @map("paid_at")
  shippedAt      DateTime?   @map("shipped_at")
  deliveredAt    DateTime?   @map("delivered_at")
  cancelledAt    DateTime?   @map("cancelled_at")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  coupon          Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items           OrderItem[]
  statusHistories OrderStatusHistory[]
  payments        Payment[]

  @@index([userId])
  @@index([couponId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// 23. OrderItem
// ---------------------------------------------------------------------------
model OrderItem {
  id           BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  orderId      BigInt  @db.UnsignedBigInt @map("order_id")
  productId    BigInt  @db.UnsignedBigInt @map("product_id")
  productName  String  @db.VarChar(500) @map("product_name")
  productImage String? @db.VarChar(500) @map("product_image")
  size         String? @db.VarChar(50)
  color        String? @db.VarChar(100)
  quantity     Int     @default(0) 
  unitPrice    BigInt  @db.UnsignedBigInt @map("unit_price")
  unitDiscount BigInt  @default(0) @db.UnsignedBigInt @map("unit_discount")
  total        BigInt  @db.UnsignedBigInt

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// 24. OrderStatusHistory
// ---------------------------------------------------------------------------
model OrderStatusHistory {
  id        BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  orderId   BigInt      @db.UnsignedBigInt @map("order_id")
  status    OrderStatus
  note      String?     @db.Text
  adminId   BigInt?     @db.UnsignedBigInt @map("admin_id")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId])
  @@index([adminId])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// 25. Payment
// ---------------------------------------------------------------------------
model Payment {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  orderId       BigInt        @db.UnsignedBigInt @map("order_id")
  gateway       String        @default("online") @db.VarChar(50)
  authority     String?       @db.VarChar(255)
  transactionId String?       @db.VarChar(255) @map("transaction_id")
  referenceId   String?       @db.VarChar(255) @map("reference_id")
  cardPan       String?       @db.VarChar(50) @map("card_pan")
  amount        BigInt        @db.UnsignedBigInt
  status        PaymentStatus @default(pending)
  paidAt        DateTime?     @map("paid_at")
  refundedAt    DateTime?     @map("refunded_at")
  rawResponse   Json?         @map("raw_response")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
  @@index([authority])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// 26. Banner
// ---------------------------------------------------------------------------
model Banner {
  id         BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  title      String         @db.VarChar(255)
  subtitle   String?        @db.VarChar(500)
  eyebrow    String?        @db.VarChar(255)
  ctaLabel   String?        @db.VarChar(100) @map("cta_label")
  href       String?        @db.VarChar(500)
  image      String         @db.VarChar(500)
  position   BannerPosition @default(hero)
  align      BannerAlign    @default(center)
  sortOrder  Int            @default(0) @map("sort_order")
  isActive   Boolean        @default(true) @map("is_active")
  startsAt   DateTime?      @map("starts_at")
  expiresAt  DateTime?      @map("expires_at")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([position])
  @@index([isActive])
  @@map("banners")
}

// ---------------------------------------------------------------------------
// 27. Feature
// ---------------------------------------------------------------------------
model Feature {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  title       String   @db.VarChar(255)
  description String   @db.Text
  icon        String?  @db.VarChar(100)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("features")
}

// ---------------------------------------------------------------------------
// 28. Page
// ---------------------------------------------------------------------------
model Page {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  title          String   @db.VarChar(255)
  slug           String   @unique @db.VarChar(255)
  content        String   @db.LongText
  seoTitle       String?  @db.VarChar(255) @map("seo_title")
  seoDescription String?  @db.Text @map("seo_description")
  isActive       Boolean  @default(true) @map("is_active")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("pages")
}

// ---------------------------------------------------------------------------
// 29. ContactMessage
// ---------------------------------------------------------------------------
model ContactMessage {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name       String   @db.VarChar(255)
  mobile     String   @db.VarChar(20)
  email      String?  @db.VarChar(255)
  subject    String?  @db.VarChar(255)
  message    String   @db.Text
  isRead     Boolean  @default(false) @map("is_read")
  repliedAt  DateTime? @map("replied_at")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// 30. Newsletter
// ---------------------------------------------------------------------------
model Newsletter {
  id       BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  email    String  @unique @db.VarChar(255)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("newsletters")
}

// ---------------------------------------------------------------------------
// 31. SiteSetting
// ---------------------------------------------------------------------------
model SiteSetting {
  id    BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  key   String      @unique @db.VarChar(255)
  value String?     @db.LongText
  type  SettingType @default(text)

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// 32. ActivityLog
// ---------------------------------------------------------------------------
model ActivityLog {
  id          BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  userType    ActivityUserType @map("user_type")
  userId      BigInt           @db.UnsignedBigInt @map("user_id")
  action      String           @db.VarChar(255)
  subjectType String?          @db.VarChar(255) @map("subject_type")
  subjectId   BigInt?          @db.UnsignedBigInt @map("subject_id")
  properties  Json?
  ipAddress   String?          @db.VarChar(45) @map("ip_address")
  userAgent   String?          @db.VarChar(500) @map("user_agent")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([userType, userId])
  @@index([subjectType, subjectId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// 33. SearchLog
// ---------------------------------------------------------------------------
model SearchLog {
  id           BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt? @db.UnsignedBigInt @map("user_id")
  query        String  @db.VarChar(500)
  resultsCount Int     @default(0)  @map("results_count")
  ipAddress    String? @db.VarChar(45) @map("ip_address")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@map("search_logs")
}

// ---------------------------------------------------------------------------
// User (not in original SQL schema but required for the app)
// ---------------------------------------------------------------------------
model User {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  mobile      String    @unique @db.VarChar(20)
  email       String?   @unique @db.VarChar(255)
  password    String    @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  addresses   Address[]
  reviews     Review[]
  wishlists   Wishlist[]
  orders      Order[]
  searchLogs  SearchLog[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// 34. MediaFolder (file manager folders)
// ---------------------------------------------------------------------------
model MediaFolder {
  id      BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  name    String  @unique @db.VarChar(255)

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  media Media[]

  @@map("media_folders")
}

// ---------------------------------------------------------------------------
// 35. Media (file manager items)
// ---------------------------------------------------------------------------
model Media {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  folderId BigInt? @db.UnsignedBigInt @map("folder_id")

  filename     String @db.VarChar(255) @map("filename")
  originalName String @db.VarChar(255) @map("original_name")
  url          String @db.VarChar(500) @map("url")
  type         String @db.VarChar(20) @default("image") @map("type") // image | video
  mimeType     String? @db.VarChar(100) @map("mime_type")
  size         Int @default(0) @map("size")
  width        Int? @map("width")
  height       Int? @map("height")
  alt          String? @db.VarChar(255) @map("alt")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  folder MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([folderId])
  @@map("media")
}
